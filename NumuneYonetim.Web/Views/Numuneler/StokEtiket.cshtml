@model Numune
@{
    ViewData["Title"] = "Stok Etiketi";
    var menseiHarfi = string.IsNullOrWhiteSpace(Model.Mensei.Ad)
        ? "?"
        : Model.Mensei.Ad.Trim()[0].ToString().ToUpperInvariant();
    var stokKodu = string.IsNullOrWhiteSpace(Model.StokNo)
        ? Model.IcTakipKodu
        : $"{menseiHarfi}-{Model.StokNo.Trim()}";
}
<div class="label-toolbar no-print"><a class="mini-btn" asp-action="Detay" asp-route-id="@Model.Id">Detaya dön</a><button class="btn" onclick="window.print()">Etiketi Yazdır</button></div>
<main class="label-stage">
  <article class="stock-label">
    <strong>@(Model.StokAlani ?? "STOK A")</strong>
    <b>@Model.Cins.Ad</b>
    <span>@stokKodu</span>
  </article>
</main>
<style>
.label-toolbar{display:flex;justify-content:flex-end;gap:10px;margin-bottom:18px}
.label-stage{display:grid;place-items:center;padding:28px;background:#e9eceb;border-radius:14px}
.stock-label{box-sizing:border-box;width:80mm;height:50mm;padding:6mm;background:#fff;color:#000;border:1px solid #aaa;font-family:Arial,sans-serif;text-transform:uppercase;display:flex;flex-direction:column;align-items:center;text-align:center}
.stock-label strong{font-size:10mm;line-height:1;font-weight:900}
.stock-label b{font-size:6mm;line-height:1.15;margin-top:4mm;font-weight:900}
.stock-label span{font-size:10mm;line-height:1;margin-top:auto;font-weight:900}
@@media(max-width:600px){.label-stage{padding:10px}.stock-label{width:100%;height:auto;aspect-ratio:1.6}.stock-label strong{font-size:clamp(30px,11vw,42px)}.stock-label b{font-size:clamp(19px,6.5vw,26px)}.stock-label span{font-size:clamp(32px,11vw,44px)}}
@@media print{.no-print,.sidebar,body>main>header{display:none!important}body>main{margin:0}.page{width:100%;padding:0}.label-stage{padding:0;background:#fff}.stock-label{border:0}@@page{size:80mm 50mm;margin:0}}
</style>
