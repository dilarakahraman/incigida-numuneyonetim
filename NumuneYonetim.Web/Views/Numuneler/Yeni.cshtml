@model NumuneOlusturVm
@{ ViewData["Title"] = "Numune Al"; }
<div class="hero compact"><div><span class="kicker">1. AŞAMA · NUMUNE ALMA</span><h1>Yeni numune kaydı</h1><p>Numune türünü, cinsi ve paketlemeyi seçin. Ürün adı seçilen cinse göre otomatik oluşur.</p></div><div class="step"><b>01</b><span>Numune alma<small>Sonraki: laboratuvar analizi</small></span></div></div>
<form method="post" class="panel form-grid">
    <div asp-validation-summary="ModelOnly"></div>
    <div class="field wide"><label asp-for="NumuneTuru">Numune türü *</label><select asp-for="NumuneTuru" id="numuneTuru"><option value="1">Susam</option><option value="2">Tahin</option></select></div>
    <div class="field wide" id="susamPaketiAlani"><label asp-for="SusamPaketiId">Susam paketlemesi *</label><select asp-for="SusamPaketiId" asp-items="ViewBag.SusamPaketleri" id="susamPaketi"><option value="">Paketleme seçin</option></select><span asp-validation-for="SusamPaketiId"></span></div>
    <div class="field wide" id="tahinPaketiAlani"><label asp-for="TahinPaketiId">Tahin paketlemesi *</label><select asp-for="TahinPaketiId" asp-items="ViewBag.TahinPaketleri" id="tahinPaketi"><option value="">Paketleme seçin</option></select><span asp-validation-for="TahinPaketiId"></span></div>
    <div class="field"><label asp-for="MenseiId">Menşei *</label><select asp-for="MenseiId" asp-items="ViewBag.Menseiler"><option value="">Menşei seçin</option></select><span asp-validation-for="MenseiId"></span></div>
    <div class="field"><label asp-for="CinsId">Cins *</label><select asp-for="CinsId" asp-items="ViewBag.Cinsler"><option value="">Cins seçin</option></select><span asp-validation-for="CinsId"></span></div>
    <div class="field"><label>Ürün adı</label><input id="urunAdiGorunum" readonly placeholder="Cins seçildiğinde otomatik oluşur" /><small>Seçilen cins ürün adı olarak kaydedilir.</small></div>
    <div class="field"><label asp-for="PaketSayisi">Paket sayısı *</label><input asp-for="PaketSayisi" type="number" min="1" /></div>
    <div class="field"><label asp-for="PaketAgirligiKg">Paket ağırlığı (kg) *</label><input asp-for="PaketAgirligiKg" type="number" min="0.01" step="0.01" /></div>
    <div class="field"><label asp-for="StokAlani">Stok alanı *</label><select asp-for="StokAlani"><option value="STOK A">STOK A</option><option value="STOK B">STOK B</option></select><span asp-validation-for="StokAlani"></span></div>
    <div class="field"><label asp-for="StokNo">Otomatik stok numarası</label><input asp-for="StokNo" readonly placeholder="Önce paketleme seçin" /><small>Her paketleme, STOK A ve STOK B için ayrı ayrı 1'den numaralandırılır.</small></div>
    <div class="field"><label asp-for="PaletNo">Palet numarası</label><input asp-for="PaletNo" placeholder="Örn. PLT-1042" /></div>
    <div class="field"><label asp-for="UretimTarihi">Üretim tarihi *</label><input asp-for="UretimTarihi" type="date" /></div>
    <div class="field"><label asp-for="NumuneAlmaTarihi">Numune alım tarihi *</label><input asp-for="NumuneAlmaTarihi" type="date" /></div>
    <div class="field"><label asp-for="Kaydeden">Numuneyi alan *</label><input asp-for="Kaydeden" /></div>
    <div class="field wide"><label asp-for="Aciklama">Açıklama</label><textarea asp-for="Aciklama" rows="3" placeholder="Varsa ek bilgi..."></textarea></div>
    <div class="form-actions"><div><b>Etiketler otomatik hazırlanır</b><small>1 stok etiketi + 1 numune etiketi</small></div><button class="btn" type="submit">Kaydet ve Etiket Oluştur →</button></div>
</form>
<script>
(() => {
    const tur = document.getElementById('numuneTuru');
    const susamAlani = document.getElementById('susamPaketiAlani');
    const tahinAlani = document.getElementById('tahinPaketiAlani');
    const susamPaketi = document.getElementById('susamPaketi');
    const tahinPaketi = document.getElementById('tahinPaketi');
    const paketleriGoster = () => {
        const susam = tur.value === '1';
        susamAlani.style.display = susam ? '' : 'none';
        tahinAlani.style.display = susam ? 'none' : '';
    };
    tur?.addEventListener('change', paketleriGoster);
    paketleriGoster();

    const cins = document.getElementById('CinsId');
    const urunAdi = document.getElementById('urunAdiGorunum');
    const urunAdiniGuncelle = () => urunAdi.value = cins?.selectedIndex > 0 ? cins.options[cins.selectedIndex].text : '';
    cins?.addEventListener('change', urunAdiniGuncelle);
    urunAdiniGuncelle();

    const alan = document.getElementById('StokAlani');
    const no = document.getElementById('StokNo');
    const stokNoGuncelle = async () => {
        const paket = tur.value === '1' ? susamPaketi : tahinPaketi;
        if (!paket?.value) {
            no.value = '';
            no.placeholder = 'Önce paketleme seçin';
            return;
        }
        no.value = 'Hesaplanıyor...';
        const params = new URLSearchParams({ stokAlani: alan.value, numuneTuru: tur.value, paketId: paket.value });
        const url = '@Url.Action("SonrakiStokNo", "Numuneler")' + '?' + params.toString();
        const response = await fetch(url);
        if (!response.ok) { no.value = ''; return; }
        const result = await response.json();
        no.value = result.stokNo;
    };
    alan?.addEventListener('change', stokNoGuncelle);
    tur?.addEventListener('change', stokNoGuncelle);
    susamPaketi?.addEventListener('change', stokNoGuncelle);
    tahinPaketi?.addEventListener('change', stokNoGuncelle);
    stokNoGuncelle();
})();
</script>
