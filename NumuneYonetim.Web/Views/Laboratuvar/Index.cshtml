@model List<Numune>
@{ ViewData["Title"] = "Laboratuvar"; }
<div class="hero compact"><div><span class="kicker">2. AŞAMA · ANALİZ</span><h1>Analiz bekleyen numuneler</h1><p>Analiz sonuçlarını girin; onaylanan numuneye anonim dış kod otomatik verilir.</p></div></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>İç kod</th><th>Menşei / Cins</th><th>Numune zamanı</th><th>Bekleme</th><th></th></tr></thead><tbody>
@foreach (var n in Model) { <tr><td><b class="code">@n.IcTakipKodu</b></td><td>@n.Mensei.Ad<small>@n.Cins.Ad</small></td><td>@n.NumuneAlmaTarihi.ToString("dd.MM.yyyy HH:mm")</td><td><span class="status s-1">Analiz bekliyor</span></td><td><a class="mini-btn" asp-action="Analiz" asp-route-id="@n.Id">Analize başla →</a></td></tr> }
</tbody></table></div>@if(Model.Count == 0){<div class="empty"><b>Bekleyen numune yok</b><span>Yeni numuneler anlık olarak burada görünecek.</span></div>}</section>
